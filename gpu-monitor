SENTINEL = "@@GPUMON1@@"

def remote_cmd(timeout):
    """Shell run on the far host: pick an interpreter and bound its lifetime.

    /usr/bin/python3 is preferred over whatever is first on PATH, because a
    conda python pulled in by .bashrc starts slower and is more fragile.

    The collector killing its local ssh does not reach the remote process, so
    the far end needs its own limits: GPUMON_DEADLINE for an orderly bail-out,
    and coreutils `timeout` as a backstop if Python itself wedges.
    """
    deadline = max(3.0, timeout - 2.0)
    return (
        f'GPUMON_DEADLINE={deadline:.1f}; export GPUMON_DEADLINE; '
        'p=/usr/bin/python3; [ -x "$p" ] || p=$(command -v python3) || exit 127; '
        f'if command -v timeout >/dev/null 2>&1; then '
        f'exec timeout -k 2 {deadline + 1.5:.1f} "$p" -; else exec "$p" -; fi'
    )

