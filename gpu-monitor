# probing
# ---------------------------------------------------------------------------

def run_probe(host, timeout, probe_src):
    """Return (payload_dict, None) or (None, reason)."""
    if host in ("local", "localhost"):
        cmd = [sys.executable, PROBE]
        stdin_data = None
    else:
        cmd = ["ssh"] + SSH_OPTS + [host, remote_cmd(timeout)]
        stdin_data = probe_src

    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE if stdin_data is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,   # own process group, so killpg below works
        )
    except (OSError, ValueError) as exc:
        return None, f"spawn-failed: {exc}"

    with LIVE_LOCK:
        LIVE_PROBES.add(proc)
    try:
        out, err_text = proc.communicate(input=stdin_data, timeout=timeout)
    except subprocess.TimeoutExpired:
        # ssh behind a ProxyJump leaves a child chain; killing only the direct
        # child would leak one process per refresh. Kill the whole group.
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            proc.kill()
        try:
            proc.communicate(timeout=3)
        except Exception:
            pass
        return None, "timeout (host hung or unreachable)"
    finally:
        with LIVE_LOCK:
            LIVE_PROBES.discard(proc)

    if SENTINEL not in out:
        err = (err_text or "").strip().splitlines()
        hint = err[-1][:80] if err else f"no data (rc={proc.returncode})"
        low = " ".join(err).lower()
        if "login.tailscale.com" in low or "authenticate" in low:
            hint = "awaiting tailscale authentication"
        elif "permission denied" in low:
            hint = "permission denied (key/2FA required)"
        return None, hint

    try:
        payload = json.loads(out.split(SENTINEL, 1)[1].strip().splitlines()[0])
    except (ValueError, IndexError) as exc:
        return None, f"bad payload: {exc}"

    if payload.get("error"):
        return None, payload["error"]
    return payload, None


def cache_path():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.join(base, "gpu-monitor", "failed.json")


class Collector:
    """Probes hosts in parallel and remembers which ones are failing.

    The failure table is persisted. Without that, backoff would only help a
    long-running pane: every `--once` invocation would start cold and pay a
    full timeout for each dead host, which is precisely the case where waiting
    12s for a one-line answer is most annoying.
    """

    def __init__(self, hosts, timeout, workers, retry_after, use_cache=True):
        self.hosts = hosts
        self.timeout = timeout
        self.retry_after = retry_after
        self.workers = max(1, min(workers, len(hosts)))
        self.use_cache = use_cache
        self.failed = {}      # host -> (reason, next_attempt_ts, failed_at_ts)
        with open(PROBE) as fh:
            self.probe_src = fh.read()
        if use_cache:
            self._load_cache()

    def _load_cache(self):
        try:
            with open(cache_path()) as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            return
        if not isinstance(data, dict):
            return
        now = time.time()
        for host, entry in data.items():
            if host not in self.hosts or not isinstance(entry, dict):
                continue
            at = entry.get("at")
            if not isinstance(at, (int, float)) or at > now + 60:
                continue  # missing, or a clock jump left it in the future
            # Derive the retry deadline from the *current* --retry-after rather
            # than a value frozen at write time, so the flag stays meaningful
            # for hosts already in the cache.
            until = at + self.retry_after
            if now < until:
                self.failed[host] = (str(entry.get("reason", "unknown")), until, at)

    def _save_cache(self):
        if not self.use_cache:
            return
        path = cache_path()
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            tmp = f"{path}.{os.getpid()}.tmp"
            with open(tmp, "w") as fh:
                json.dump({h: {"reason": r, "at": at}
                           for h, (r, _u, at) in self.failed.items()}, fh)
            os.replace(tmp, path)
        except OSError:
            pass

    def due(self, host, now):
        entry = self.failed.get(host)
        return entry is None or now >= entry[1]

    def poll(self):
        now = time.time()
        active = [h for h in self.hosts if self.due(h, now)]
        results, skipped = {}, {}

        if active:
            with futures.ThreadPoolExecutor(max_workers=self.workers) as pool:
                fut = {pool.submit(run_probe, h, self.timeout, self.probe_src): h
                       for h in active}
                for f in futures.as_completed(fut):
                    host = fut[f]
                    try:
                        payload, reason = f.result()
                    except Exception as exc:
                        payload, reason = None, f"probe error: {exc}"
                    if payload:
                        results[host] = payload
                        self.failed.pop(host, None)
                    else:
                        now_f = time.time()
                        self.failed[host] = (reason, now_f + self.retry_after, now_f)

        if active:
            self._save_cache()
        for host, (reason, _until, _at) in self.failed.items():
            skipped[host] = reason
        return results, skipped


