def gib(nbytes):
    return f"{nbytes / 2**30:.3f}Gi"


def rate(bytes_per_s):
    if bytes_per_s is None:
        return "N/A"
    v = float(bytes_per_s)
    for unit in ("B/s", "KiB/s", "MiB/s", "GiB/s"):
        if v < 1024 or unit == "GiB/s":
            return f"{v:.1f} {unit}"
        v /= 1024
    return f"{v:.1f} GiB/s"


def human(nbytes):
    if nbytes is None:
        return "-"
    v = float(nbytes)
    for unit in ("B", "K", "M", "G", "T"):
        if v < 1024:
            return f"{v:.0f}{unit}" if unit == "B" else f"{v:.1f}{unit}"
        v /= 1024
    return f"{v:.1f}P"


def opt(value, width=0, decimals=None):
    """Format a possibly-absent nvidia-smi field.

    nvidia-smi reports [N/A] for temperature, fan and power on plenty of cards
    (passthrough VMs, some datacenter parts), which arrives here as None.
    Formatting None against a width spec raises, and a single such GPU would
    otherwise take down the entire multi-host display.
    """
    if value is None:
        return "N/A".rjust(width)
    if decimals is not None:
        return f"{value:>{width}.{decimals}f}"
    return f"{value:>{width}}" if width else f"{value}"


def bar(frac, width, label, c):
    """nvtop-style meter: '|' fill with the label right-aligned inside."""
    frac = max(0.0, min(1.0, frac))
    fill = int(round(frac * width))
    content = label.rjust(width)[:width]
    out = []
    for i, ch in enumerate(content):
        if i < fill:
            out.append("|" if ch == " " else ch)
        else:
            out.append(ch)
    body = "".join(out)
    color = c["green"] if frac < 0.6 else c["yellow"] if frac < 0.85 else c["red"]
    return f"{color}{body[:fill]}{c['reset']}{body[fill:]}"


ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")

# Below this a GPU panel stops being readable, so the grid drops a column
# rather than shredding every line.
MIN_PANEL = 34

# The process table is never squeezed below this, even on a short terminal;
# the device grid gives up lines first.
MIN_PROC_ROWS = 3

# Share of the process table given to your own processes; the rest goes to
# everyone else's. Either section can borrow whatever the other cannot use.
MINE_SHARE = 0.70

# Hosts alternate between these two colours so adjacent ones are easy to tell
# apart. Parity is taken over the hosts actually displayed, not the file order:
# otherwise a skipped host would put two neighbours on the same colour.
HOST_COLORS = ("cyan", "magenta")


def host_colors(live_hosts, c):
    """{host: colour} alternating by display position."""
    return {h: c[HOST_COLORS[i % len(HOST_COLORS)]]
            for i, h in enumerate(live_hosts)}


def vlen(s):
    """Visible width, ignoring colour escapes."""
    return len(ANSI_RE.sub("", s))


def vpad(s, w):
    return s + " " * max(0, w - vlen(s))


def clip(s, w):
    """Truncate plain text to w columns, marking the cut."""
    return s if len(s) <= w else s[:max(0, w - 1)] + "~"


def grid_shape(n, spec, width):
    """Return (rows, cols, panel_width) for `n` GPU devices.

    Default rule: rows = trunc(sqrt(devices)), then columns follow from it.
    The unit is the device, not the host, so a 2-GPU box occupies two cells.

    Columns are clamped so a panel never falls below MIN_PANEL, which keeps a
    narrow terminal from turning the grid into confetti; rows are then
    recomputed from the surviving column count so the two always agree.
    """
    n = max(1, n)
    if spec == "stack":
        cols = 1
    elif spec == "auto":
        rows = max(1, int(math.sqrt(n)))        # truncate, per the layout rule
        cols = math.ceil(n / rows)
    else:
        rows_s, _, cols_s = spec.partition("x")
        try:
            rows = max(1, int(rows_s))
            # Columns are authoritative when given; otherwise they follow from
            # the requested row count, same rule as 'auto'.
            cols = max(1, int(cols_s)) if cols_s.strip() else math.ceil(n / rows)
        except ValueError:
            rows = max(1, int(math.sqrt(n)))
            cols = math.ceil(n / rows)
    cols = max(1, min(cols, n, max(1, (width + 2) // (MIN_PANEL + 2))))
    rows = math.ceil(n / cols)
    panel_w = max(MIN_PANEL, (width - 2 * (cols - 1)) // cols)
    return rows, cols, panel_w


def uptime_short(seconds):
    """Compact uptime: 12d4h / 4h12m / 12m."""
    if seconds is None:
        return "?"
    days, rest = divmod(int(seconds), 86400)
    hours, rest = divmod(rest, 3600)
    mins = rest // 60
    if days:
        return f"{days}d{hours}h"
    if hours:
        return f"{hours}h{mins}m"
    return f"{mins}m"


def short_name(name):
    """'NVIDIA GeForce RTX 2080 Ti' -> 'RTX 2080 Ti', for narrow panels."""
    for prefix in ("NVIDIA GeForce ", "NVIDIA TITAN ", "NVIDIA "):
        if name.startswith(prefix):
            return name[len(prefix):]
    return name


def rate_short(bytes_per_s):
    """Compact throughput ('19.0M') for panels with no room for '19.0 MiB/s'."""
    if bytes_per_s is None:
        return "N/A"
    v = float(bytes_per_s)
    for unit in ("B", "K", "M", "G"):
        if v < 1024 or unit == "G":
            return f"{v:.0f}{unit}" if unit == "B" else f"{v:.1f}{unit}"
        v /= 1024
    return f"{v:.1f}G"


def device_panel(host, wsl, g, hostinfo, width, c, hcolor=""):
    """One GPU's nvtop block, laid out to fit exactly `width` columns.

    Every panel is a single device, so all cells in the grid have the same
    height and the layout stays rectangular regardless of how many GPUs each
    host has.

    Wide panels get the full nvtop one-liner. Narrow ones reflow onto extra
    lines rather than truncating, so PCIe/RX/TX survive a many-column grid
    instead of being cut off the right-hand edge.

    The trailing CPU line describes the whole machine, not the device, so on a
    multi-GPU host it repeats in each of that host's panels. That is deliberate:
    every panel stays the same height, which is what keeps the grid rectangular.
    """
    lines = []
    head = f"{host}{' (wsl)' if wsl else ''}"
    wide = width >= 76
    gen = f"{opt(g['pcie_gen'])}@{opt(g['pcie_width'])}x"

    # Colour only the leading host name, so clipping the tail can never sever
    # an escape sequence.
    tag = f"{c['bold']}{hcolor}{head}{c['reset']}"
    if wide:
        lines.append(tag + clip(
            f" · Device {g['index']} [{g['name']}] PCIe GEN {gen}"
            f" RX: {rate(g.get('rx'))} TX: {rate(g.get('tx'))}",
            width - len(head)))
        lines.append(clip(
            f" GPU {opt(g['clk_gr'])}MHz MEM {opt(g['clk_mem'])}MHz"
            f" TEMP {opt(g['temp'], 3)}°C FAN {opt(g['fan'], 3)}%"
            f" POW {opt(g['power'], 3, 0)}/{opt(g['power_cap'], 3, 0)}W", width))
    else:
        lines.append(tag + clip(
            f" · Dev {g['index']} [{short_name(g['name'])}]", width - len(head)))
        lines.append(clip(f" PCIe GEN {gen}  RX {rate_short(g.get('rx'))}"
                          f" TX {rate_short(g.get('tx'))}", width))
        lines.append(clip(
            f" {opt(g['clk_gr'])}/{opt(g['clk_mem'])}MHz"
            f" {opt(g['temp'])}°C {opt(g['fan'])}%"
            f" {opt(g['power'], 0, 0)}/{opt(g['power_cap'], 0, 0)}W", width))

    used = (g["mem_used"] or 0) * 2**20
    total = (g["mem_total"] or 1) * 2**20
    util = g["util"] or 0
    memlabel = f"{gib(used)}/{gib(total)}"
    # Side by side when there is room, stacked when there is not.
    if width >= 2 * MIN_PANEL + 4:
        meter = (width - 12) // 2
        lines.append(f" GPU[{bar(util / 100, meter, f'{util}%', c)}]"
                     f" MEM[{bar(used / total, meter, memlabel, c)}]")
    else:
        meter = max(8, width - 6)
        lines.append(f" GPU[{bar(util / 100, meter, f'{util}%', c)}]")
        lines.append(f" MEM[{bar(used / total, meter, memlabel, c)}]")

    # Whole-machine CPU context. Usage is normalised across all cores, so
    # 100% means every core is busy rather than one core saturated.
    hi = hostinfo or {}
    cores, pct = hi.get("cores"), hi.get("cpu")
    busy, tasks, threads = hi.get("cores_busy"), hi.get("tasks"), hi.get("threads")
    up = uptime_short(hi.get("uptime"))
    # "5/20c" reads as five of twenty cores loaded, which distinguishes a few
    # pinned threads from an evenly-busy machine at the same mean.
    corestr = f"{opt(cores)}c" if busy is None else f"{busy}/{opt(cores)}c"
    if wide:
        stats = (f" {corestr}  {opt(tasks)} tasks  {opt(threads)} thr"
                 f"  up {up}")
    else:
        stats = f" {corestr} {opt(tasks)}p {opt(threads)}t {up}"
    # On a big machine (256 cores, five-digit thread counts) the text alone can
    # exceed a narrow panel, so clip it before sizing the meter -- otherwise the
    # meter bottoms out at its floor and the line spills past the panel edge.
    stats = clip(stats, max(0, width - 12))
    meter = max(6, width - 6 - len(stats))
    label = "N/A" if pct is None else f"{pct:.1f}%"
    lines.append(f" CPU[{bar((pct or 0) / 100, meter, label, c)}]{stats}")
    return lines


def render_grid(results, hosts, spec, width, c, hcolor=None):
    """Tile every GPU into a grid, filling columns top-to-bottom.

    Cells are laid out vertically first: reading down column one gives the
    first `rows` devices, then column two continues from there. Devices keep
    hosts.txt order, so a host's GPUs stay adjacent.
    """
    devices = []
    for host in hosts:
        payload = results.get(host)
        if not payload:
            continue
        wsl = payload.get("host_kind") == "wsl"
        for g in payload.get("gpus", []):
            devices.append((host, wsl, g, payload.get("host")))
    if not devices:
        return [], "0x0"

    rows, cols, panel_w = grid_shape(len(devices), spec, width)
    hcolor = hcolor or {}
    panels = [device_panel(h, w, g, hi, panel_w, c, hcolor.get(h, ""))
              for h, w, g, hi in devices]

    out = []
    for r in range(rows):
        cells = []
        for col in range(cols):
            idx = col * rows + r          # column-major: down, then across
            cells.append(panels[idx] if idx < len(panels) else [])
        height = max((len(p) for p in cells), default=0)
        for line in range(height):
            out.append("  ".join(
                vpad(p[line] if line < len(p) else "", panel_w) for p in cells
            ).rstrip())
        out.append("")
    return out, f"{rows}x{cols}"


