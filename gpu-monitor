def render(results, skipped, hosts, width, c, show_skipped, layout='auto',
           height=0, offsets=None, focus="mine"):
    """Render the full view.

    Returns (text, meta) where meta maps each process section to
    (total_rows, visible_rows, clamped_offset), so the caller can bound
    scrolling against what actually fit.
    """
    offsets = offsets or {}
    lines = []
    ngpu = sum(len(p.get("gpus", [])) for p in results.values())
    nproc = sum(len(p.get("procs", [])) for p in results.values())
    hcolor = host_colors([h for h in hosts if results.get(h)], c)
    grid_lines, shape = render_grid(results, hosts, layout, width, c, hcolor)
    lines.append(
        f"{c['bold']}{c['cyan']}gpu-monitor{c['reset']}  "
        f"{len(results)}/{len(hosts)} hosts up · {ngpu} GPUs · {nproc} processes"
        f"{c['dim']}   grid {shape}   {time.strftime('%H:%M:%S')}{c['reset']}"
    )
    lines.append("")
    # grid_lines are held back: if the terminal is shorter than the grid, they
    # get trimmed too, so the view never overflows into terminal scrollback.

    # ---- process table, split by ownership ---------------------------------
    rows = []
    for host in hosts:
        payload = results.get(host)
        if not payload:
            continue
        for p in payload.get("procs", []):
            rows.append((host, p))
    rows.sort(key=lambda r: (-(r[1].get("gpu_mem") or 0), -(r[1].get("cpu") or 0)))

    # Ownership is decided on each host by the probe, against the account it
    # runs as there -- the ssh user differs per machine, so it cannot be
    # inferred from one local username.
    mine_rows = [r for r in rows if r[1].get("mine")]
    other_rows = [r for r in rows if not r[1].get("mine")]

    # Footer first: it competes with the process rows for the remaining lines,
    # so it has to be measured before deciding how many rows fit.
    footer = []
    if any(r.get("host_kind") == "wsl" for r in results.values()):
        footer.append(
            f"{c['dim']}(wsl) hosts cannot report per-process GPU memory through "
            f"NVML; {c['cyan']}cyan{c['reset']}{c['dim']} values are self-reported "
            f"by wslnvtop-run.{c['reset']}"
        )
    if skipped:
        if show_skipped:
            for h, why in sorted(skipped.items()):
                footer.append(f"{c['dim']}  skipped {h}: {why}{c['reset']}")
        else:
            footer.append(
                f"{c['dim']}{len(skipped)} host(s) skipped "
                f"({', '.join(sorted(skipped))}) -- --show-skipped for why.{c['reset']}"
            )

    hostw = max([4] + [len(h) for h, _ in rows])
    hdr = (f"  {'HOST':<{hostw}} {'PID':>8} {'USER':<10} {'DEV':>3} {'TYPE':<4} "
           f"{'GPU':>4} {'GPU MEM':>9} {'CPU':>6} {'HOST MEM':>9}  COMMAND")

    sections = [("mine", "yours", mine_rows), ("others", "other users", other_rows)]
    shown = [s for s in sections if s[2]]          # skip an empty section entirely

    # Split the available height between the device grid and the process rows.
    # `height <= 0` means "no limit" (piped output, or --once).
    if height and height > 0:
        # status(2) + column header + rule + trailing blank + footer + 1 spare
        fixed = len(lines) + 3 + len(footer) + 1 + len(shown)
        # Guarantee the process table a few rows, trimming the grid if the
        # terminal is too short to show every device.
        grid_budget = max(0, height - fixed - MIN_PROC_ROWS)
        if len(grid_lines) > grid_budget:
            per = grid_lines.index("") + 1 if "" in grid_lines else 1
            keep = max(0, (grid_budget - 1) // max(1, per) * max(1, per))
            if len(grid_lines) - keep > 0:
                grid_lines = grid_lines[:keep]
                grid_lines.append(
                    f"{c['dim']}  ... device grid truncated to fit the terminal "
                    f"(use a taller window or -L stack){c['reset']}")
        capacity = max(1, height - (len(lines) + len(grid_lines) + 3
                                    + len(footer) + 1 + len(shown)))
    else:
        capacity = len(rows)
    lines.extend(grid_lines)

    # 70% of the rows go to your processes, 30% to everyone else. Whatever a
    # section cannot use is handed to the other rather than left blank.
    caps = {"mine": 0, "others": 0}
    if len(shown) == 1:
        caps[shown[0][0]] = capacity
    elif shown:
        caps["mine"] = max(1, int(round(capacity * MINE_SHARE)))
        caps["others"] = max(1, capacity - caps["mine"])
        for a, b in (("mine", "others"), ("others", "mine")):
            spare = caps[a] - len(mine_rows if a == "mine" else other_rows)
            if spare > 0:
                caps[a] -= spare
                caps[b] += spare

    lines.append(f"{c['bold']}{hdr}{c['reset']}")
    lines.append(c["dim"] + "-" * min(width, 200) + c["reset"])

    if not rows:
        lines.append(f"  {c['dim']}no GPU processes on any reachable host{c['reset']}")

    prefix = 2 + hostw + 1 + 8 + 1 + 10 + 1 + 3 + 1 + 4 + 1 + 4 + 1 + 9 + 1 + 6 + 1 + 9 + 2
    cmdw = max(20, width - prefix)
    meta = {}
    for key, label, srows in sections:
        total = len(srows)
        visible = min(caps[key], total)
        off = max(0, min(offsets.get(key, 0), max(0, total - visible)))
        meta[key] = (total, visible, off)
        if not total:
            continue

        marker = f"{c['bold']}▸{c['reset']}" if key == focus else " "
        scroll = ""
        if total > visible:
            scroll = f"  rows {off + 1}-{off + visible} of {total}"
        lines.append(
            f"{marker} {c['bold']}{label}{c['reset']}{c['dim']} ({total})"
            f"{scroll}{c['reset']}"
        )
        for host, p in srows[off:off + visible]:
            cmd = p.get("cmd", "?")
            if len(cmd) > cmdw:
                cmd = cmd[:cmdw - 1] + "~"
            sm = p.get("sm")
            gmem = p.get("gpu_mem")
            gcol = c["cyan"] if p.get("self_reported") else ""
            tcol = c["green"] if p.get("type", "C").startswith("C") else c["blue"]
            ucol = c["bold"] if p.get("mine") else c["dim"]
            lines.append(
                f"  {hcolor.get(host, '')}{host:<{hostw}}{c['reset']} {p['pid']:>8} "
                f"{ucol}{clip(str(p.get('user', '?')), 10):<10}{c['reset']} "
                f"{('-' if p.get('dev') is None else p['dev']):>3} "
                f"{tcol}{p.get('type', 'C'):<4}{c['reset']} "
                f"{('-' if sm is None else f'{sm}%'):>4} "
                f"{gcol}{human(gmem):>9}{c['reset']} "
                f"{p.get('cpu', 0):>6.1f} {human(p.get('rss', 0)):>9}  {cmd}"
            )

    lines.append("")
    lines.extend(footer)
    return "\n".join(lines), meta


# ---------------------------------------------------------------------------

def load_hosts(path):
    hosts = []
    with open(path) as fh:
        for line in fh:
            line = line.split("#", 1)[0].strip()
            if line and line not in hosts:
                hosts.append(line)
    return hosts


def close_masters(hosts):
    for h in hosts:
        if h in ("local", "localhost"):
            continue
        r = subprocess.run(["ssh"] + SSH_OPTS + ["-O", "exit", h],
                           capture_output=True, text=True)
        print(f"  {h}: {'closed' if r.returncode == 0 else 'no live master'}")


def main():
    ap = argparse.ArgumentParser(
        description="nvtop-style GPU monitoring across many hosts over ssh.")
    ap.add_argument("-f", "--hosts", default=DEFAULT_HOSTS,
                    help=f"host list file (default: {DEFAULT_HOSTS})")
    ap.add_argument("-d", "--delay", type=float, default=3.0,
                    help="refresh interval in seconds (default: 3)")
    ap.add_argument("-t", "--timeout", type=float, default=12.0,
                    help="per-host hard timeout in seconds (default: 12)")
    ap.add_argument("-j", "--workers", type=int, default=16,
                    help="max concurrent probes (default: 16)")
    ap.add_argument("--retry-after", type=float, default=45.0,
                    help="seconds before re-probing a failed host (default: 45)")
    ap.add_argument("-1", "--once", action="store_true", help="print once and exit")
    ap.add_argument("--show-skipped", action="store_true",
                    help="show why each host was skipped")
    ap.add_argument("--close", action="store_true",
                    help="close persistent ssh masters for all hosts and exit")
    ap.add_argument("-L", "--layout", default="auto", metavar="SPEC",
                    help="host grid: 'auto' (rows=trunc(sqrt(hosts)), columns "
                         "derived), 'stack' for one full-width column, or an "
                         "explicit RxC such as 2x4 / 3x5. Columns are reduced "
                         "if the terminal is too narrow.")
    ap.add_argument("--no-cache", action="store_true",
                    help="ignore the persisted failed-host cache and probe every host")
    ap.add_argument("--no-color", action="store_true")
    ap.add_argument("-V", "--version", action="version",
                    version=f"multi-host-gpu-monitor {VERSION}")
    args = ap.parse_args()

    spec = args.layout.strip().lower()
    if spec not in ("auto", "stack"):
        parts = spec.partition("x")
        ok = parts[0].isdigit() and (parts[2] == "" or parts[2].isdigit())
        if not ok:
            print(f"error: bad --layout {args.layout!r}; expected 'auto', "
                  f"'stack', or RxC such as 3x5", file=sys.stderr)
            return 1
    args.layout = spec

    if not os.path.exists(args.hosts):
        # A fresh clone has no hosts.txt (it is gitignored), so fall back to the
        # shipped example rather than refusing to start.
        if args.hosts == DEFAULT_HOSTS and os.path.exists(EXAMPLE_HOSTS):
            print(f"note: no {os.path.basename(DEFAULT_HOSTS)} yet, using "
                  f"{os.path.basename(EXAMPLE_HOSTS)}. "
                  f"Copy it and add your machines:\n"
                  f"  cp {EXAMPLE_HOSTS} {DEFAULT_HOSTS}", file=sys.stderr)
            args.hosts = EXAMPLE_HOSTS
        else:
            print(f"error: no host list at {args.hosts}", file=sys.stderr)
            return 1
    hosts = load_hosts(args.hosts)
    if not hosts:
        print(f"error: {args.hosts} lists no hosts", file=sys.stderr)
        return 1

    if args.close:
        close_masters(hosts)
        return 0

    c = paint(not args.no_color and sys.stdout.isatty())
    collector = Collector(hosts, args.timeout, args.workers, args.retry_after,
                          use_cache=not args.no_cache)

    if args.once:
        # One-shot output is meant for piping and inspection, so it is never
        # height-limited: print every process row.
        results, skipped = collector.poll()
        width = shutil.get_terminal_size((160, 40)).columns
        out, _meta = render(results, skipped, hosts, width, c,
                            args.show_skipped, args.layout)
        print(out)
        return 0

    # Killing in-flight probes on the way out matters: a stalled ssh behind a
    # ProxyJump would otherwise be orphaned and linger for its full timeout.
    def bail(_sig, _frm):
        kill_live_probes()
        raise KeyboardInterrupt

    for sig in (signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(sig, bail)
        except (ValueError, OSError):
            pass

    offsets = {"mine": 0, "others": 0}
    focus = "mine"
    results, skipped = {}, {}
    next_poll = 0.0
    dirty = True

    try:
        with KeyReader(sys.stdin.isatty()) as keys:
            while True:
                if time.monotonic() >= next_poll:
                    results, skipped = collector.poll()
                    next_poll = time.monotonic() + max(0.5, args.delay)
                    dirty = True

                if dirty:
                    size = shutil.get_terminal_size((160, 40))
                    out, meta = render(
                        results, skipped, hosts, size.columns, c,
                        args.show_skipped, args.layout,
                        height=size.lines, offsets=offsets, focus=focus)
                    for k, (_t, _v, clamped) in meta.items():
                        offsets[k] = clamped
                    sys.stdout.write("\033[H\033[J" + out + "\n")
                    sys.stdout.flush()
                    dirty = False

                # Wake for whichever comes first: a keypress or the next poll.
                # Capped so a long --delay still feels responsive to scrolling.
                budget = max(0.05, min(next_poll - time.monotonic(), 0.25))
                key = keys.get(budget)
                if key in ("q", "esc"):
                    break
                if key == "tab":
                    # Scrolling acts on one section at a time; Tab picks which.
                    focus = "others" if focus == "mine" else "mine"
                    dirty = True
                elif key:
                    total, visible, _off = meta.get(focus, (0, 0, 0))
                    new = scroll_to(key, offsets[focus], visible, total)
                    if new != offsets[focus]:
                        offsets[focus], dirty = new, True
    except KeyboardInterrupt:
        pass
    finally:
        kill_live_probes()
        sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
