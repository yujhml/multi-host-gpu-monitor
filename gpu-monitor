# Live probe subprocesses, so they can be killed on the way out instead of
# being orphaned. concurrent.futures joins its workers at interpreter exit, so
# without this a Ctrl-C waits out the slowest ssh before the process dies.
LIVE_PROBES = set()
LIVE_LOCK = threading.Lock()


def kill_live_probes():
    with LIVE_LOCK:
        procs = list(LIVE_PROBES)
        LIVE_PROBES.clear()
    for proc in procs:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            try:
                proc.kill()
            except OSError:
                pass


ESC_KEYS = {
    "[A": "up", "[B": "down", "[H": "home", "[F": "end",
    "OA": "up", "OB": "down", "OH": "home", "OF": "end",
    "[5~": "pgup", "[6~": "pgdn", "[1~": "home", "[4~": "end",
    "[Z": "tab",                      # shift-tab, treated the same
}
PLAIN_KEYS = {
    "k": "up", "j": "down", "g": "home", "G": "end",
    "b": "pgup", " ": "pgdn", "u": "pgup", "d": "pgdn",
    "q": "q", "\t": "tab",
}


class KeyReader:
    """Read single keypresses without waiting for Enter.

    Puts the terminal in cbreak mode for the lifetime of the monitor and always
    restores it, including on an exception -- leaving a shell with echo off is
    a genuinely hostile way to exit.
    """

    def __init__(self, enabled):
        self.enabled = bool(enabled) and hasattr(termios, "tcgetattr")
        self.fd = None
        self.saved = None

    def __enter__(self):
        if self.enabled:
            try:
                self.fd = sys.stdin.fileno()
                self.saved = termios.tcgetattr(self.fd)
                tty.setcbreak(self.fd)
            except (termios.error, OSError, ValueError):
                self.enabled = False
        return self

    def __exit__(self, *_exc):
        if self.enabled and self.saved is not None:
            try:
                termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
            except (termios.error, OSError):
                pass
        return False

    def _read(self, timeout):
        """Raw read of whatever is pending, or None on timeout.

        Deliberately os.read() on the file descriptor rather than
        sys.stdin.read(): sys.stdin is buffered, so a single read() can pull an
        entire escape sequence into Python's buffer, after which select() on
        the fd reports "nothing ready" while bytes are already in hand. Mixing
        the two silently mis-parses every arrow key.
        """
        try:
            ready, _, _ = select.select([self.fd], [], [], timeout)
        except (OSError, ValueError):
            time.sleep(timeout)
            return None
        if not ready:
            return None
        try:
            data = os.read(self.fd, 64)
        except OSError:
            return None
        return data.decode("utf-8", "replace") if data else None

    def get(self, timeout):
        """Return a key name, or None if `timeout` elapsed with no input."""
        if not self.enabled:
            time.sleep(timeout)
            return None
        s = self._read(timeout)
        if not s:
            return None
        if not s.startswith("\x1b"):
            return PLAIN_KEYS.get(s[0])
        # Terminals usually deliver an escape sequence in one burst, but not
        # always; give the remainder a moment before calling it a bare Esc.
        if len(s) == 1:
            more = self._read(0.05)
            if not more:
                return "esc"
            s += more
        return ESC_KEYS.get(s[1:])


def scroll_to(key, offset, visible, total):
    """New scroll offset for a key, clamped to the available rows."""
    page = max(1, visible - 1)
    moves = {"up": -1, "down": 1, "pgup": -page, "pgdn": page}
    if key == "home":
        offset = 0
    elif key == "end":
        offset = total - visible
    elif key in moves:
        offset += moves[key]
    return max(0, min(offset, max(0, total - visible)))


